<?xml version="1.0" encoding="utf-8"?>
<!-- Only the official feed. The project has no third-party packages; restore only pulls Microsoft's
     .NET runtime packs (for self-contained publish) and the trimmer. Settings here apply to this
     folder only; the user-wide NuGet config is not changed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="pdm-nuget-official" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="pdm-nuget-official">
      <package pattern="Microsoft.*" />
      <package pattern="runtime.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
